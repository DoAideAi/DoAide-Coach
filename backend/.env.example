# Copy to backend/.env (never commit it) or set in the systemd unit.
PORT=3103
SITE_URL=https://coach.doaide.com

# Gemini: server-side only. Set either the key or a path to a file containing it.
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=/Users/dev/projects/keys/gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google sign-in (OAuth Web client ID; public by design).
GOOGLE_CLIENT_ID=
# Long random string; keeps sign-ins valid across restarts.
SESSION_SECRET=

DB_PATH=./coach.db
CORS_ORIGINS=http://localhost:3104,https://coach.doaide.com
AI_RATE_LIMIT=40
AI_RATE_WINDOW=600
