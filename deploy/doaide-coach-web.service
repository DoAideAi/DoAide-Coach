[Unit]
Description=DoAide Coach Web (static frontend)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/DoAide-Coach/frontend
# SPA fallback lives in dist/serve.json (from public/) so static /guides pages win over it;
# `-s` would put its catch-all rewrite ahead of those rules.
ExecStart=/usr/bin/npx serve dist -l 3104
Restart=always

[Install]
WantedBy=multi-user.target
