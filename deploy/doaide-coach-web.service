[Unit]
Description=DoAide Coach Web (static frontend)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/DoAide-Coach/frontend
# Routing lives in dist/serve.json (from public/): guide pages, then the SPA routes.
# `-s` would put a catch-all rewrite ahead of those rules and hide /guides.
ExecStart=/usr/bin/npx serve dist -l tcp://172.18.0.1:3104 --no-clipboard
Restart=always

[Install]
WantedBy=multi-user.target
